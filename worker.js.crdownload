// Cloudflare Worker: secure proxy between your portfolio chatbot and an AI API.
// The API key lives ONLY here (as a secret), never in GitHub or frontend code.
//
// Environment variables (set in Cloudflare dashboard or with wrangler):
//   PROVIDER        "gemini" (default) | "claude" | "openai"
//   GEMINI_API_KEY  / ANTHROPIC_API_KEY / OPENAI_API_KEY   (secrets)
//   GEMINI_MODEL / CLAUDE_MODEL / OPENAI_MODEL             (optional, see defaults below)
//   ALLOWED_ORIGIN  comma-separated list of allowed site origins, e.g.
//                   https://yourusername.github.io,https://yourdomain.com   (leave unset to allow any)

const SYSTEM_PROMPT = `You are the AI assistant on Kashaf Gull's portfolio website.

About Kashaf:
- WordPress specialist and freelance web developer/designer based in Faisalabad, Pakistan.
- BS Software Engineering graduate (NUML, 2025).
- Skills: WordPress, WooCommerce, Elementor, Shopify, custom HTML/CSS/JavaScript, plus some React and Node.js. Her site also lists Divi, PHP, SEO and page speed.
- Runs an agency called Winksols.
- Works with startups, small businesses and agencies, from landing pages to full e-commerce stores.
- Contact: the Contact section of this site, Fiverr, Instagram/Facebook, or LinkedIn (linkedin.com/in/kashaf-gull).

Services: custom WordPress design, WooCommerce stores, plugin development, speed optimization (Core Web Vitals), security and maintenance, and site migration to WordPress.

Featured projects:
- Sehra-e-Khaas (https://sehra-e-khaas.com/): e-commerce store for a US-based fashion brand, built on WordPress/WooCommerce with custom HTML, CSS and JavaScript. Includes a hand-coded header, product galleries, live cart and search, variation swatches, size charts, and a unique "Story" page for every product.
- Royal Aesthetica Clinic (https://royalaestheticaclinic.com/): premium aesthetics and beauty clinic website with treatment pages and appointment booking, built with Elementor.
- Werex Trans (https://werextrans.com/): transport and logistics company website with service pages, fleet information and contact features, built with Elementor.
- Cybitix (https://cybitix.com/): website for an AI and engineering firm covering AI agents, web and mobile, blockchain and staff augmentation, built with Next.js.
- Golden Castle (Faisalabad): restaurant website with an animated hero carousel.

Rules:
- Answer only about Kashaf, her services, skills, projects and how to hire her. Politely decline unrelated topics.
- Never invent projects, prices, clients, results or facts. Only describe projects using the details above; if asked for more detail, say Kashaf can share it on request.
- Keep replies short (2-4 sentences). Always reply in English, even if the visitor writes in another language.
- For hiring or quotes, point people to the Contact section of this site.`;

const MAX_MSG_CHARS = 500;
const MAX_HISTORY = 8;
const RATE_LIMIT = 20;          // requests
const RATE_WINDOW_MS = 10 * 60 * 1000; // per 10 minutes, per IP (best-effort, per isolate)

const hits = new Map();

function rateLimited(ip) {
  const now = Date.now();
  const rec = hits.get(ip);
  if (!rec || now > rec.reset) {
    hits.set(ip, { count: 1, reset: now + RATE_WINDOW_MS });
    return false;
  }
  rec.count++;
  return rec.count > RATE_LIMIT;
}

function allowedOrigins(env) {
  return (env.ALLOWED_ORIGIN || "*").split(",").map((s) => s.trim()).filter(Boolean);
}

function originAllowed(env, origin) {
  const list = allowedOrigins(env);
  return list.includes("*") || list.includes(origin);
}

function corsHeaders(env, origin) {
  const list = allowedOrigins(env);
  const star = list.includes("*");
  return {
    "Access-Control-Allow-Origin": star ? "*" : list.includes(origin) ? origin : list[0],
    "Access-Control-Allow-Methods": "POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type",
    "Vary": "Origin",
  };
}

function json(body, status, headers) {
  return new Response(JSON.stringify(body), {
    status,
    headers: { "Content-Type": "application/json", ...headers },
  });
}

async function callGemini(env, messages) {
  const model = env.GEMINI_MODEL || "gemini-2.5-flash";
  const res = await fetch(
    `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent`,
    {
      method: "POST",
      headers: { "Content-Type": "application/json", "x-goog-api-key": env.GEMINI_API_KEY },
      body: JSON.stringify({
        systemInstruction: { parts: [{ text: SYSTEM_PROMPT }] },
        contents: messages.map((m) => ({
          role: m.role === "assistant" ? "model" : "user",
          parts: [{ text: m.content }],
        })),
        generationConfig: { maxOutputTokens: 400, temperature: 0.6 },
      }),
    }
  );
  if (!res.ok) throw new Error("gemini " + res.status);
  const data = await res.json();
  return data.candidates?.[0]?.content?.parts?.map((p) => p.text).join("") || "";
}

async function callClaude(env, messages) {
  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "x-api-key": env.ANTHROPIC_API_KEY,
      "anthropic-version": "2023-06-01",
    },
    body: JSON.stringify({
      model: env.CLAUDE_MODEL || "claude-haiku-5-5",
      max_tokens: 400,
      system: SYSTEM_PROMPT,
      messages,
    }),
  });
  if (!res.ok) throw new Error("claude " + res.status);
  const data = await res.json();
  return data.content?.[0]?.text || "";
}

async function callOpenAI(env, messages) {
  const res = await fetch("https://api.openai.com/v1/chat/completions", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: "Bearer " + env.OPENAI_API_KEY,
    },
    body: JSON.stringify({
      model: env.OPENAI_MODEL || "gpt-4o-mini",
      max_tokens: 400,
      messages: [{ role: "system", content: SYSTEM_PROMPT }, ...messages],
    }),
  });
  if (!res.ok) throw new Error("openai " + res.status);
  const data = await res.json();
  return data.choices?.[0]?.message?.content || "";
}

export default {
  async fetch(request, env) {
    const origin = request.headers.get("Origin") || "";
    const cors = corsHeaders(env, origin);

    if (request.method === "OPTIONS") return new Response(null, { status: 204, headers: cors });
    if (request.method !== "POST") return json({ error: "Method not allowed" }, 405, cors);

    if (!originAllowed(env, origin)) {
      return json({ error: "Forbidden" }, 403, cors);
    }

    const ip = request.headers.get("CF-Connecting-IP") || "unknown";
    if (rateLimited(ip)) return json({ error: "Too many requests. Please try again in a few minutes." }, 429, cors);

    let body;
    try {
      body = await request.json();
    } catch {
      return json({ error: "Bad JSON" }, 400, cors);
    }

    const messages = (Array.isArray(body.messages) ? body.messages : [])
      .filter((m) => m && (m.role === "user" || m.role === "assistant") && typeof m.content === "string")
      .slice(-MAX_HISTORY)
      .map((m) => ({ role: m.role, content: m.content.slice(0, MAX_MSG_CHARS) }));

    if (!messages.length || messages[messages.length - 1].role !== "user") {
      return json({ error: "No user message" }, 400, cors);
    }

    try {
      const provider = (env.PROVIDER || "gemini").toLowerCase();
      const reply =
        provider === "claude" ? await callClaude(env, messages)
        : provider === "openai" ? await callOpenAI(env, messages)
        : await callGemini(env, messages);
      if (!reply) throw new Error("empty reply");
      return json({ reply }, 200, cors);
    } catch (err) {
      return json({ error: "AI service unavailable" }, 502, cors);
    }
  },
};
